<% content_for(:title, t('.title')) %>
<div class="m-3">
  <div class="col-md-12 col-lg-10 mx-auto px-5">
    <h2>パスワード新規作成</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field my-5 px-5">
        <%= f.label :新しいパスワード %><br />
        <% if @minimum_password_length %>
          <em>(<%= @minimum_password_length %> 文字以上)</em><br />
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %>
      </div>

      <div class="field my-5 px-5">
        <%= f.label :新しいパスワード再確認 %><br />
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
      </div>

      <div class="actions">
        <%= f.submit "パスワードを変更する" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
