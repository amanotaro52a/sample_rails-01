<div class="row mb-3" id="comment-form">
  <div class="col-lg-8 offset-lg-2">
    <%= form_with model: comment, url: work_comments_path(work) do |f| %>
      <%= f.label :感想 %>
      <%= f.text_area :body, class: "form-control mb-3", row: "4", placeholder: Comment.human_attribute_name(:コメントを書いてみよう) %>
      <%= f.submit "コメントをする", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>