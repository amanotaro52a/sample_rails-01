<header>
  <nav class='navbar navbar-expand-lg navigation navbar-light bg-light' data-turbo="false">
    <%= link_to '/', class: 'navbar-brand' do %>
      <h1>書道展</h1>
    <% end %>  
    <button class='navbar-toggler' data-bs-toggle='collapse' data-bs-target='#navbarSupportedContent'
      aria-controls='navbarSupportedContent' aria-expanded='false' aria-label='Toggle navigation'>
      <span class='navbar-toggler-icon'></span>
    </button>

    <div class='collapse navbar-collapse' id='navbarSupportedContent'>
      <ul class='navbar-nav ms-auto main-nav align-items-center'>
        <li class='nav-item dropdown dropdown-slide'>
          <%= link_to '作品展', '#', class: 'nav-link dropdown-toggle', data: { bs_toggle: 'dropdown' }, aria: { haspopup: 'true', expanded: 'false' }, id: 'header-work-menu' %>
          <div class='dropdown-menu dropdown-menu-end'>
            <%= link_to '作品一覧', works_path, class: 'dropdown-item' %>
            <%= link_to '新たに作品を展示する', new_work_path, class: 'dropdown-item' %>
          </div>
        </li>

        <li class='nav-item'>
          <%= link_to 'お気に入り一覧', bookmarks_works_path, class: 'nav-link' %>
        </li>
        <% if user_signed_in? %>
          <li class='nav-item dropdown dropdown-side'>
            <%= link_to '#', class: 'nav-link', data: { bs_toggle: 'dropdown' }, aria: { haspopup: 'true', expanded: 'false' }, id: 'header-profile' do %>
              <%= image_tag 'icon.jpg', class: 'rounded-circle mr15', width: '40', height: '40' %>
            <% end %>
            <div class='dropdown-menu dropdown-menu-end'>
              <div class='dropdown-item'><%= current_user.decorate.name %></div>
              <div class='dropdown-divider'></div>
              <%= link_to 'ユーザー設定', profile_path, class: 'dropdown-item' %>
              <%= link_to 'ログアウト', destroy_user_session_path, method: :delete, class: 'dropdown-item' %>
            </div>  
          </li>
        <% else %>  
          <li class='nav-item'>
            <%= link_to '新規作成', new_user_registration_path, class: 'nav-link' %>
          </li>
          <li class='nav-item'>
            <%= link_to 'ログイン', new_user_session_path, class: 'nav-link' %>
          </li>
        <% end %>
      </ul>
    </div>
  </nav>
</header>