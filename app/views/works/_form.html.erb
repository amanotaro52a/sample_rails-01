<%= form_with model: @work do |f| %>
  <div class="mb-3">
    <%= f.label :title %>
    <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :body %>
    <%= f.text_area :body, class: "form-control", rows: "10" %>
  </div>
  <div class="mb-3">
    <%= f.label :image %>
    <%= f.file_field :image, class: "form-control", accept: 'image/*' %>
  </div>
  <%= f.submit nil, class: "btn btn-primary" %>
<% end %>