<% content_for(:title, t('.title')) %>
<div class="container pt-3">
  <div class="row">
    <div class="col-lg-10 offset-lg-1">
      <%= render "search_form", q: @q, url: bookmarks_works_path %>
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      <div class="row">
        <% if @bookmark_works.present? %>
          <%= render @bookmark_works %>            
        <% else %>
          <div class="mb-3"><%= t('.no_result') %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
