<div class="container">
  <div class="row">
    <div class="col-lg-8 offset-lg-2">
      <h1>作品新規作成</h1>
      <%= form_with model: @work, class: "new_work" do |f| %>
        <div class="mb-3">
          <%= f.label :タイトル %>
          <%= f.text_field :title, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.label :説明 %>
          <%= f.text_area :body, class: "form-control", rows: "10" %>
        </div>
        <%= f.submit nil, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div> 
</div>