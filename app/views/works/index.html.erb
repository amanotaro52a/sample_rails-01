<% content_for(:title, t('.title')) %>
<div class="container pt-3">
  <div class="row">
    <div class="col-lg-10 offset-lg-1">
      <%= render "search_form", q: @q, url: works_path %>
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      <div class="row">
        <% if @works.present? %>
          <%= render @works %>            
        <% else %>
          <div class="mb-3">作品がありません</div>
        <% end %>
      </div>
      <%== @pagy.series_nav(:bootstrap) %>
    </div>
  </div>
</div>
